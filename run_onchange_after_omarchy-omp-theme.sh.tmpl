#!/usr/bin/env bash
#
# Renders the omp theme template through omarchy and pushes the result into
# ~/.omp/agent/themes/omarchy-system.json.
#
# The template only renders inside `omarchy theme set`, which writes every
# ~/.config/omarchy/themed/*.tpl into the current-theme state dir and then fires
# the theme-set hooks. So a fresh machine and an edited template both need one
# re-apply to converge; the theme-set.d hook handles every switch after that.
#
# run_onchange_, keyed on the template below, so a plain `chezmoi apply` does
# not re-apply the theme on every run.
#
# omp.json.tpl: {{ include "dot_config/omarchy/themed/omp.json.tpl" | sha256sum }}
# omp-theme.hook: {{ include "dot_config/omarchy/hooks/theme-set.d/executable_omp-theme.hook" | sha256sum }}

set -euo pipefail

# Nothing to render for, or nothing to render with.
[[ -d $HOME/.omp/agent ]] || exit 0
command -v omarchy-theme-refresh >/dev/null || exit 0

# Keeps the background: this is a re-render, not a theme change.
omarchy-theme-refresh

#!/usr/bin/env bash
#
# Restores the fingerprint topic guide inside the packaged omarchy agent skill.
#
# /usr/share/omarchy/ is owned by the omarchy package, so `omarchy update`
# wipes both the guide and the link to it in SKILL.md. This runs on every
# `chezmoi apply` (not run_onchange_, whose hash would not change when the
# destination is wiped) and only escalates when something is actually missing.

set -euo pipefail

skill_dir="/usr/share/omarchy/default/agents/skills/omarchy"
guide="$skill_dir/fingerprint.md"
index="$skill_dir/SKILL.md"
link='- [`fingerprint.md`](fingerprint.md) - fingerprint readers, TOD drivers, enrollment, and fingerprint PAM'

# Nothing to restore if omarchy is not installed from the package tree.
[[ -d $skill_dir ]] || exit 0

staged=$(mktemp)
trap 'rm -f "$staged"' EXIT
cat >"$staged" <<'CHEZMOI_GUIDE_EOF'
{{ include ".chezmoitemplates/omarchy/fingerprint.md" | trimSuffix "\n" }}
CHEZMOI_GUIDE_EOF

guide_ok=false
cmp -s "$staged" "$guide" && guide_ok=true

link_ok=false
# `--` matters: the link starts with "- [", which grep would parse as options.
grep -qxF -- "$link" "$index" && link_ok=true

if $guide_ok && $link_ok; then
  exit 0
fi

echo "Restoring fingerprint.md in the omarchy agent skill (needs root)..."

if ! $guide_ok; then
  pkexec install -Dm644 -o root -g root "$staged" "$guide"
fi

if ! $link_ok; then
  # Anchor on the capture.md entry of the Topic Guides list, not on any prose
  # mention of capture.md — "Example Requests" cites it too, and an unanchored
  # match inserts the link into that list as well. First match only.
  pkexec sed -i "0,/^- \[\`capture\.md\`\]/s##$link\n&#" "$index"
fi

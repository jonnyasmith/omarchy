#!/usr/bin/env bash
# Regenerate the public-key stubs ~/.ssh/config pins per host.
#
# The private halves never leave 1Password. ssh still needs a local file to say
# *which* agent key to use for a host, and that is all a stub is — it matches
# on the key blob, not the comment, so the comments are generic.
set -euo pipefail

export SSH_AUTH_SOCK="$HOME/.1password/agent.sock"

# Written into the chezmoi source directory, not straight into ~. A rotated key
# is a change to the desired state, so it belongs in a commit; `chezmoi apply`
# is what puts it in ~/.ssh/1password, which the private_ attribute makes 0700.
#
# Nothing here chmods anything: each source file is named `private_*.pub`, so
# chezmoi writes it 0600. That mode is load-bearing — OpenSSH 10.5 refuses a
# 0644 IdentityFile outright ("Permissions 0644 ... are too open") even when
# the file holds nothing but a public key. Hence source paths are resolved per
# *file*, not by joining a directory: `chezmoi source-path` on the directory
# drops the per-file attribute prefix and would silently create a second,
# 0644 source entry for every stub.
src() {
  local target="$HOME/.ssh/1password/$1.pub"
  # Absent target means a new stub: chezmoi cannot resolve a source path for
  # it, so name one, keeping the prefix.
  chezmoi source-path "$target" 2>/dev/null ||
    printf '%s/private_%s.pub\n' "$(chezmoi source-path ~/.ssh/1password)" "$1"
}

# The work items are titled "... Work" rather than after the employer, so this
# repo names no client. These strings are also what
# ~/.config/1Password/ssh/agent.toml lists: rename an item in the vault and
# both files need the new title. An unmapped key is reported and skipped.
map() {
  case "$1" in
    "SSH Key - Ed25519")      echo github-personal ;;
    "SSH Key - Ed25519 Work") echo github-work ;;
    "SSH Key - Work")         echo azure-work ;;
    *)                        echo "" ;;
  esac
}

[[ -S $SSH_AUTH_SOCK ]] || {
  echo "1Password agent socket not found; is 1Password running with the SSH agent enabled?" >&2
  exit 1
}

found=0
while read -r type key comment; do
  [[ -n ${type:-} ]] || continue
  name=$(map "$comment")
  if [[ -z $name ]]; then
    echo "skip: unmapped 1Password key '$comment' (add it to map() above)" >&2
    continue
  fi
  path="$(src "$name")"
  printf '%s %s %s\n' "$type" "$key" "$comment" > "$path"
  echo "wrote $path  <- $comment"
  found=$((found + 1))
done < <(ssh-add -L)

[[ $found -gt 0 ]] || { echo "no keys returned by the agent" >&2; exit 1; }

echo
echo "review with 'chezmoi diff', then 'chezmoi apply' and commit in $(chezmoi source-path)"

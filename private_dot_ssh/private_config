# ~/.ssh/config — `chezmoi edit ~/.ssh/config`.
#
# One key per host, with IdentitiesOnly. Without it ssh offers every key the
# agent holds and the first one the server accepts wins — which silently
# authenticated work repos as the personal account. Past six keys it stops
# being a correctness problem and becomes a hard failure: ssh exhausts the
# server's MaxAuthTries and gives up with "Too many authentication failures".
#
# Every block is `Match originalhost`, not `Host`. The github-work alias sets
# HostName github.com, so a `Host github.com` block matches it too — both
# identities load and agent order picks the account, which is the same bug
# IdentitiesOnly was meant to close.
#
# The .pub stubs name which agent key to use; the private halves never leave
# 1Password. chezmoi writes them as real files, so they exist from the first
# apply and only chezmoi can remove them. ssh treats a missing IdentityFile as
# fatal for the host, so a vanished stub breaks every remote at once.
# Regenerate them with `~/.ssh/1password/refresh`.

Match originalhost github.com
  HostName github.com
  User git
  IdentitiesOnly yes
  IdentityFile ~/.ssh/1password/github-personal.pub

# Nothing reaches this alias by hand: ssh sees a hostname, never a repo, so the
# `insteadOf` rewrites generated into ~/.config/git/config.local are the only
# thing that routes a work remote here. That file is rendered from
# dot_config/git/config.local.tmpl, one rewrite per entry in `workOrgs`.
#
# An owner missing from `workOrgs` therefore gets no rewrite, silently keeps the
# personal key, and GitHub reports the private repo as "not found" rather than
# as a permission error. The matching `includeIf hasconfig` blocks miss too, so
# commits are authored with the personal address. Add the owner to `workOrgs`
# and re-apply; do NOT hand-edit a remote to this alias, which fixes the key but
# not the email. `workOrgs` takes owners exactly as they appear in a clone URL,
# so a personal-account owner needs its own entry — an org slug does not cover it.
Match originalhost github-work
  HostName github.com
  User git
  IdentitiesOnly yes
  IdentityFile ~/.ssh/1password/github-work.pub

# Only the RSA key is registered with Azure DevOps.
Match originalhost ssh.dev.azure.com,vs-ssh.visualstudio.com
  User git
  IdentitiesOnly yes
  IdentityFile ~/.ssh/1password/azure-work.pub
  PubkeyAcceptedAlgorithms +ssh-rsa
  HostkeyAlgorithms +ssh-rsa

# Tailnet machines, reached by MagicDNS short name. All three authorize this one
# key — pinning it keeps the two work keys from being offered to a personal box,
# and turns a missing authorization into "Permission denied (publickey)" rather
# than the MaxAuthTries failure three offered keys produce.
#
# The two Linux boxes get their sshd from run_after_sshd-tailnet.sh. macmini is
# macOS Remote Login instead, so nothing in this repo hardens it: its sshd is
# launchd-socket-activated, which ignores ListenAddress, and it has no ufw. See
# README for what has to be done on the box by hand.
Match originalhost minisforum,dell-xps,macmini,minisforum-herdr,dell-xps-herdr
  User jonny
  IdentitiesOnly yes
  IdentityFile ~/.ssh/1password/github-personal.pub

# Attach aliases for `herdr --remote minisforum-herdr`. Same machines, reached
# the same way; the only thing the alias adds is the agent forward below.
Host minisforum-herdr
  HostName minisforum
Host dell-xps-herdr
  HostName dell-xps

# Hand this machine's 1Password agent to the far end at a fixed path, so a git
# push from a `herdr --remote` pane raises its approval dialog here, on the
# screen being looked at, instead of on the remote box's physical Wayland
# session where it waits forever and git just hangs.
#
# RemoteForward, not ForwardAgent, because of how Herdr is built: ForwardAgent
# publishes a random per-connection path in $SSH_AUTH_SOCK, and the Herdr server
# outlives any single ssh connection while its panes inherit the environment it
# started with -- so that variable is absent or points at a closed connection's
# socket by the second attach. A constant path has no environment to go stale.
#
# A constant path has the opposite failure, though, and it is why this lives on
# a dedicated alias instead of on the plain host names: every connection carrying
# this option rebinds the same socket, and sshd does not unlink it on close. A
# one-shot `ssh minisforum some-command` would therefore steal the path from a
# live Herdr session and leave a dead socket behind on exit, breaking git in
# every pane with "Error connecting to agent: Connection refused". Confining the
# forward to the attach alias means only the long-lived connection that needs it
# ever binds it, and `ssh minisforum` stays harmless.
#
# The remote sshd needs StreamLocalBindUnlink yes to replace the socket left by
# the previous attach; run_after_sshd-tailnet.sh sets it. Both paths are absolute
# because RemoteForward does not expand ~ on either side.
Match originalhost *-herdr
  RemoteForward /home/jonny/.ssh/1password-forwarded.sock /home/jonny/.1password/agent.sock

# Use a forwarded agent, but only on the far side of an ssh connection. This is
# what makes the block above do anything: without it the `Host *` default below
# wins on first-obtained-value and the far end keeps asking its own local
# 1Password.
#
# $SSH_CONNECTION is the discriminator, and existence of the socket is not
# enough on its own. Both machines share this file and forward to the same path,
# so a session in the other direction -- or a socket sshd left behind -- puts
# that file on the machine being sat at too, and a bare `test -S` then sends
# *local* git to the other box's 1Password, where the approval prompt is once
# again on a screen nobody is looking at. sshd sets $SSH_CONNECTION only for the
# remote end, and a Herdr pane inherits it from the server, so this matches
# exactly the sessions the forward was made for.
Match exec "test -n \"$SSH_CONNECTION\" && test -S /home/jonny/.ssh/1password-forwarded.sock"
  IdentityAgent /home/jonny/.ssh/1password-forwarded.sock

Host *
  # 1Password's Linux agent socket. Nothing listens here until the SSH agent is
  # enabled in 1Password → Settings → Developer; a stale path and an unset one
  # fail identically, so this is written unconditionally.
  IdentityAgent ~/.1password/agent.sock

Host pi-development.local
  HostName pi-development.local
  User jonny
  ForwardAgent yes

Host homepi.local
  HostName homepi.local
  User jonny
  ForwardAgent yes

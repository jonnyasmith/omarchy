# Omarchy environment (OMARCHY_PATH + PATH), needed even for non-interactive shells
[[ -r /usr/share/omarchy/default/bash/env-bootstrap ]] && source /usr/share/omarchy/default/bash/env-bootstrap

# If not running interactively, don't do anything else (leave this above the rc source)
[[ $- != *i* ]] && return

# ble.sh — the bash line editor that provides inline autosuggestions and
# syntax highlighting (the zsh-autosuggestions + fast-syntax-highlighting
# replacement). It must be sourced *before* anything that installs a
# PROMPT_COMMAND — starship and mise, both in Omarchy's rc below — and
# attached only at the very bottom, once every other hook is registered.
# That is what --noattach / ble-attach are for. Its own settings live in
# ~/.config/blesh/init.sh, which ble.sh sources by itself.
[[ -r /usr/share/blesh/ble.sh ]] && source /usr/share/blesh/ble.sh --noattach

# Starship reads its config from the current Omarchy theme, not
# ~/.config/starship.toml, which does not exist. The file is rendered from
# ~/.config/omarchy/themed/starship.toml.tpl by every `omarchy theme set`.
# Must be exported before Omarchy's rc runs `starship init bash`. Guarded
# because a theme with no colors.toml is never rendered, and pointing
# STARSHIP_CONFIG at a missing file silently yields the stock prompt.
_starship_config="$HOME/.local/state/omarchy/current/theme/starship.toml"
[[ -r $_starship_config ]] && export STARSHIP_CONFIG="$_starship_config"
unset _starship_config

# All the default Omarchy aliases and functions
# (don't mess with these directly, just overwrite them here!)
source "$OMARCHY_PATH/default/bash/rc"

# Personal aliases and functions, sourced after Omarchy's so they win.
for _bashrc_d in ~/.config/bash/*.sh; do
	[[ -r $_bashrc_d ]] && source "$_bashrc_d"
done
unset _bashrc_d

# Rust toolchain, if rustup put one here. Appended by rustup's installer and
# guarded because the file only exists once rustup has run on this machine.
[[ -r $HOME/.cargo/env ]] && . "$HOME/.cargo/env"

# Hand the line editor over to ble.sh. Must stay last.
[[ ${BLE_VERSION-} ]] && ble-attach

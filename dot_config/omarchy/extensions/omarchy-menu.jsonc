{
  // Extend the Quickshell Omarchy menu with JSONC.
  //
  // IDs are object keys. The parent is inferred from the dotted id, so
  // "personal.notes" appears under "personal", and "personal" appears on the
  // root menu. Reuse an existing id to override/extend it.
  //
  // Fields:
  //   icon        Nerd Font glyph shown in the icon column.
  //   label       Visible row title.
  //   action      Shell command to run. If omitted, the row is a submenu.
  //   target      Existing submenu id to open. Use for links/aliases.
  //   provider    Runtime provider function/command returning JSON rows.
  //   aliases     alternate `omarchy menu summon <name>` routes; also searchable.
  //   description Optional subtitle and extra search text.
  //   when        Shell condition; hide row when it fails.
  //   checked     Shell condition; append ✓ when it succeeds.
  //
  // Examples:
  // "personal": {"icon":"","label":"Personal"},
  // "personal.notes": {"icon":"󰎞","label":"Notes","action":"omarchy-launch-editor ~/notes"},
  // "personal.files": {"icon":"","label":"Files","action":"uwsm-app -- nautilus ~/Documents"},
  //
  // Only use provider when a provider_name function or command named "name"
  // returns JSON rows. Static submenus only need dotted ids.
  //
  // Example: replace the default About action by reusing the same id. Existing
  // fields are kept unless overridden.
  // "about": {"icon":"","label":"About","action":"omarchy-launch-or-focus-tui \"zsh -c 'fastfetch; read -k 1'\""},

  // One container for everything in ~/.config/omarchy/plugins/, rather than a
  // row per tool on the root menu: the root list is Omarchy's, and appending
  // to it does not scale past two or three. A row with no `action` is a
  // submenu, and the parent is inferred from the dotted id, so every future
  // tool is one "plugins.<name>" line and nothing else has to change.
  // Its children stay searchable from the root -- SUPER + SPACE then "port"
  // still reaches the picker -- so the extra level costs nothing typed.
  "plugins": {"icon":"\uf12e","label":"Plugins","description":"Personal tools: audio outputs, dev ports, USB drives"},

  // Dev ports: the same picker SUPER + ALT + P opens, for when the chord is
  // not in muscle memory yet. Same glyph as the bar widget (0xF048D).
  // TUI.float is the app-id Omarchy's window rules float; the one derived from
  // the script name is not, and the terminal would tile.
  "plugins.ports": {"icon":"󰒍","label":"Dev ports","description":"Pick a listening local dev server and open it","aliases":["ports"],"action":"omarchy-launch-tui --app-id=TUI.float $HOME/.config/omarchy/plugins/jonny.ports/ports-tui.sh"},

  // USB drives: the same picker SUPER + ALT + U opens. The glyph is written as
  // a JSON \u escape rather than the character itself -- Nerd Font glyphs are
  // private-use codepoints, and an editor or a clipboard that does not know
  // that drops them silently.
  "plugins.usb": {"icon":"\uf287","label":"USB drives","description":"Format a drive, write a bootable ISO, or power one off for safe removal","aliases":["usb","drives"],"action":"omarchy-launch-tui --app-id=TUI.float $HOME/.config/omarchy/plugins/jonny.usb/usb-tui.sh"},

  // Audio outputs: local PipeWire sinks and network AirPlay receivers in one
  // picker. A switch also moves streams already playing; r rebuilds AirPlay
  // sinks after a receiver has dropped its RTSP session.
  "plugins.audio": {"icon":"\uf028","label":"Audio output","description":"Switch system audio between local speakers, HomePods, and Apple TVs","aliases":["audio","airplay","homepod","speakers"],"action":"omarchy-launch-tui --app-id=TUI.float $HOME/.config/omarchy/plugins/jonny.audio/audio-tui.sh"}
}
